# ─────────────────────────────────────────────
# Database PostgreSQL
# ─────────────────────────────────────────────
# Pilih salah satu sesuai environment yang digunakan:

# Opsi 1: Lokal (pgAdmin / PostgreSQL lokal)
# Ganti "postgres" dengan username PostgreSQL kamu,
# "passwordkamu" dengan password, dan "nama_database" dengan nama database yang sudah dibuat.
# DATABASE_URL=postgresql://postgres:passwordkamu@localhost:5432/nama_database

# Opsi 2: Supabase (cloud) — gunakan Connection Pooler, bukan Direct Connection
# Ambil dari: Project Settings → Database → Connection string → Connection Pooler
# Pastikan pakai port 6543 (bukan 5432)
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:passwordkamu@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Aktifkan salah satu di atas (hapus tanda # di depannya), lalu isi nilainya:
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/your_database

# ─────────────────────────────────────────────
# Cloudinary (untuk upload gambar)
# Daftar akun gratis di https://cloudinary.com
# Ambil nilai dari: Cloudinary Dashboard → API Keys
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
